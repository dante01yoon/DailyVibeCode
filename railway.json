{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "buildCommand": "NODE_ENV=development npm install && npm run build"
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 10
  }
}
